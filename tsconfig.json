{
  "compilerOptions": {
    "target": "ESNext",
    "module": "CommonJS",
    "moduleResolution": "bundler",
    "paths": {
      "@app/*": ["./src/app/*"],
      "@env/*": ["./src/environments/*"],
      "@testData/*": ["../../test-data/*"]
    },
    "types": ["@playwright/test"],
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["tests", "helpers", "playwright.config.ts", "e2e.config.ts"]
}
